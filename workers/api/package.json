{
  "name": "@myytengine/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute myytengine --remote --file=src/db/schema.sql",
    "db:init:local": "wrangler d1 execute myytengine --local --file=src/db/schema.sql",
    "test": "vitest run",
    "test:remote": "vitest run --config vitest.remote.config.ts",
    "test:phase5": "vitest run --config vitest.phase5.config.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.0.30"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "typescript": "^5.8.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.129.1"
  }
}
