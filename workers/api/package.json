{
  "name": "@myytengine/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute myytengine --remote --file=src/db/schema.sql",
    "db:init:local": "wrangler d1 execute myytengine --local --file=src/db/schema.sql",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.0.30"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^5.8.2",
    "vitest": "^2.1.0",
    "wrangler": "^3.90.0"
  }
}
