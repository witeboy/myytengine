# Public build-time settings. Every VITE_ value is compiled into the bundle, so nothing
# secret may ever go here — provider keys live in the BYOK vault behind the Worker.
# Copy to .env.local for development; set the same names in Vercel for Preview/Production.

# The API Worker
VITE_API_BASE=https://myytengine-api.tolu-adebisi.workers.dev

# Neon Managed Better Auth (branch-aware URL from the Neon console)
VITE_NEON_AUTH_URL=
